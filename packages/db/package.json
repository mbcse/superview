{
  "name": "@takeandstake/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "tsx src/migrate.ts && prisma db push --accept-data-loss --skip-generate",
    "seed": "tsx src/seed.ts",
    "build": "prisma generate",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}
