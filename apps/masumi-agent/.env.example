# MIP-003 SuperView research agent (Cardano Preprod / Sokosumi)
PORT=8080
HOST=0.0.0.0

# Live SuperView API. Railway: https://api.superview.fun
SUPERVIEW_API_URL=https://api.superview.fun
# Required when ALLOW_DEMO_USER=false on the API. Must be a Privy bearer, not the payment key.
SUPERVIEW_AUTH_TOKEN=Bearer REPLACE
# SUPERVIEW_DEMO_USER=masumi-agent

NETWORK=Preprod
AGENT_IDENTIFIER=REPLACE_APPROVED_SOKOSUMI_ID
# Friend's payment service, public ngrok URL ending in /api/v1
PAYMENT_SERVICE_URL=https://REPLACE.ngrok-free.app/api/v1
PAYMENT_API_KEY=REPLACE_FROM_MPS
SELLER_VKEY=REPLACE_FROM_MPS

RESEARCH_POLL_MS=2000
RESEARCH_TIMEOUT_MS=600000
PAYMENT_POLL_MS=5000
PAY_WINDOW_MS=3600000
MASUMI_JOBS_PATH=data/masumi-jobs.json
