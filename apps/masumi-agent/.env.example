# MIP-003 SuperView research agent (Cardano / Sokosumi track)
PORT=8080
HOST=0.0.0.0

# Existing SuperView API — do not change apps/api; call it over HTTP
SUPERVIEW_API_URL=http://127.0.0.1:4000

# Auth for POST /v1/research (non-prod demo header OR Privy bearer)
# Prefer SUPERVIEW_AUTH_TOKEN=Bearer <privy> in shared environments.
SUPERVIEW_DEMO_USER=masumi-agent
# SUPERVIEW_AUTH_TOKEN=

# Masumi / Railway Preprod (see deploy/railway/masumi.env.example)
NETWORK=Preprod
AGENT_IDENTIFIER=
PAYMENT_SERVICE_URL=http://127.0.0.1:3012/api/v1
PAYMENT_API_KEY=
SELLER_VKEY=
# Production: use SUPERVIEW_AUTH_TOKEN=Bearer ... and public PAYMENT_SERVICE_URL / agent HTTPS


# Poll SuperView research until DRAFT / FAILED
RESEARCH_POLL_MS=2000
RESEARCH_TIMEOUT_MS=600000
