# Sokosumi + Masumi payment glue (does not change SuperView DB)
PORT=8090
HOST=0.0.0.0

# Your MIP-003 agent
MASUMI_AGENT_URL=http://127.0.0.1:8080

# Payment source of truth = Masumi Payment Service (not SuperView)
# Personal / local unpaid smoke: MOCK_PAYMENTS=true (skip escrow).
# Railway / judges paid Preprod: MOCK_PAYMENTS=false + PAYMENT_API_KEY + paymentId.
# See deploy/railway/masumi.env.example
MOCK_PAYMENTS=true
PAYMENT_SERVICE_URL=http://127.0.0.1:3012/api/v1
PAYMENT_API_KEY=
NETWORK=Preprod

# How long to wait for MPS to report funded escrow before failing the Task
PAYMENT_POLL_MS=3000
PAYMENT_TIMEOUT_MS=900000

# Optional: submit resultHash to MPS after agent completes (when paid)
SUBMIT_RESULT_HASH=true

# Agent poll
AGENT_POLL_MS=2000
AGENT_TIMEOUT_MS=900000
