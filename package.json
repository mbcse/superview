{
  "name": "takeandstake",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @takeandstake/db generate",
    "db:migrate": "pnpm --filter @takeandstake/db migrate",
    "db:seed": "pnpm --filter @takeandstake/db seed",
    "start:api": "pnpm --filter @takeandstake/api start",
    "start:worker": "pnpm --filter @takeandstake/worker start",
    "start:web": "pnpm --filter @takeandstake/web start",
    "dev:masumi-agent": "pnpm --filter @takeandstake/masumi-agent dev",
    "dev:masumi-worker": "pnpm --filter @takeandstake/masumi-worker dev",
    "start:masumi-agent": "pnpm --filter @takeandstake/masumi-agent start",
    "start:masumi-worker": "pnpm --filter @takeandstake/masumi-worker start",
    "smoke:masumi-personal": "bash scripts/masumi-personal-smoke.sh",
    "spike": "pnpm --filter @takeandstake/chain exec tsx ../../scripts/spikes/run.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
