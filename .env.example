NODE_ENV=development
APP_MODE=paper
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/takeandstake
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Railway sets PORT. The API uses PORT when present.
# WEB_ORIGIN=https://your-web.vercel.app
# API_ORIGIN=https://<api-service>.up.railway.app
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Auth / wallets
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_WEBHOOK_SECRET=
# App-pays gas for Privy deposit / transfer / swap. Turn on in the Privy dashboard too.
PRIVY_GAS_SPONSORED=1
ALCHEMY_WEBHOOK_TOKEN=

# Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Extra RH RPCs, comma-separated. Pool also pulls chain 4663 from https://chainlist.org/rpcs.json
ROBINHOOD_RPC_URLS=
ALCHEMY_RPC_URL=
ZEROX_API_KEY=
JUPITER_API_KEY=
BAGS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URLS=
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URLS=
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_RPC_URLS=
USDC_BASE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AUSD_MONAD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
# Required in production. At least 32 characters. Used to sign Mera session tokens.
SESSION_JWT_SECRET=
MERA_RP_ID=superview.fun
KURU_FLOW_URL=https://ws.kuru.io
# Aurora Intents — Base USDC → Monad AUSD. Create at https://studio.aurora.dev
AURORA_INTENTS_API_KEY=
# Optional Nansen holders/netflow line on Monad venue picks
NANSEN_API_KEY=
NEXT_PUBLIC_MERA_RP_ID=superview.fun
LIVE_MAX_TRADE_USD_MEMES=250
LIVE_DAILY_CAP_USD_MEMES=1000

# Research — OpenAI key must be OPENAI_API_KEY (sk-proj- or sk-). Anthropic must be sk-ant-.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MANUS_API_KEY=
FMP_API_KEY=

# Models
RESEARCH_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
CRITIC_MODEL=claude-haiku-4-5
SOCIAL_MODEL=claude-haiku-4-5
BENCHMARK_SYMBOLS=SPY,RHSPY,VOO,IVV
PAPER_STARTING_USD=10000
LIVE_MAX_TRADE_USD=2000
LIVE_DAILY_CAP_USD=10000
# Extra live spend targets, comma-separated 0x addresses. USDG is always included. Empty client lists cannot widen this.
LIVE_ALLOWED_CONTRACTS=
ORACLE_MAX_DEVIATION=0.015

# Ops
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=takeandstake-evidence
RESEND_API_KEY=
SENTRY_DSN=
ADMIN_TOKEN=dev-admin-token
# Demo user fallback is on in development. Production stays off unless this is true.
ALLOW_DEMO_USER=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_POSTHOG_KEY=phc_5918n4s3UPJOIawjTciuy5YrGdotlvB1dTpoZFPTdkM
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
