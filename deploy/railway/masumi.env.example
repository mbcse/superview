# =============================================================================
# Railway env for masumi-agent — Cardano PREPROD
# Payment Service stays on a teammate machine and is exposed with ngrok.
# Never commit real values.
# =============================================================================

# --- Service: masumi-agent (Dockerfile.masumi-agent) — PUBLIC domain ---
PORT=8080
HOST=0.0.0.0
SUPERVIEW_API_URL=https://api.superview.fun
SUPERVIEW_AUTH_TOKEN=Bearer REPLACE_PRIVY_TOKEN
NETWORK=Preprod
AGENT_IDENTIFIER=REPLACE_APPROVED_SOKOSUMI_ID
PAYMENT_SERVICE_URL=https://REPLACE.ngrok-free.app/api/v1
PAYMENT_API_KEY=REPLACE_FROM_MPS
SELLER_VKEY=REPLACE_FROM_MPS
RESEARCH_POLL_MS=2000
RESEARCH_TIMEOUT_MS=600000
PAYMENT_POLL_MS=5000
PAY_WINDOW_MS=3600000

# --- Payment Service (friend's masumi-payment-service, not this repo) ---
# Expose with ngrok, then paste that https URL into PAYMENT_SERVICE_URL above.
# ADMIN_KEY / ENCRYPTION_KEY / BLOCKFROST_API_KEY_PREPROD / selling wallet mnemonic
# stay on that machine. Selling wallet needs Preprod ADA for fees.
#
# Preprod tUSDM unit (MPS register pricing):
