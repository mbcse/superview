# =============================================================================
# Railway env paste templates — Cardano PREPROD only (Mainnet skipped)
# Never commit real values. Give teammate filled secrets via 1Password / vault.
# =============================================================================

# --- Service: superview (existing deploy/railway/Dockerfile) ---
# NODE_ENV=production
# APP_MODE=paper
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# API_ORIGIN=https://${{RAILWAY_PUBLIC_DOMAIN}}
# WEB_ORIGIN=https://your-web.vercel.app
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# ADMIN_TOKEN=
# ALLOW_DEMO_USER=false

# --- Service: masumi-agent (Dockerfile.masumi-agent) — PUBLIC domain ---
PORT=8080
HOST=0.0.0.0
SUPERVIEW_API_URL=https://REPLACE-superview.up.railway.app
# Prefer Bearer for prod; demo header only if ALLOW_DEMO_USER is on
SUPERVIEW_AUTH_TOKEN=Bearer REPLACE
# SUPERVIEW_DEMO_USER=masumi-agent
NETWORK=Preprod
PAYMENT_SERVICE_URL=https://REPLACE-mps.up.railway.app/api/v1
PAYMENT_API_KEY=REPLACE_FROM_MPS_ADMIN
SELLER_VKEY=REPLACE_VKEY_FROM_MPS_WALLETS
AGENT_IDENTIFIER=REPLACE_AFTER_MPS_REGISTER_OR_EXISTING
RESEARCH_POLL_MS=2000
RESEARCH_TIMEOUT_MS=600000

# --- Service: masumi-worker (Dockerfile.masumi-worker) — private OK ---
# PORT=8090
# HOST=0.0.0.0
MASUMI_AGENT_URL=https://REPLACE-masumi-agent.up.railway.app
MOCK_PAYMENTS=false
PAYMENT_SERVICE_URL=https://REPLACE-mps.up.railway.app/api/v1
PAYMENT_API_KEY=REPLACE_FROM_MPS_ADMIN
NETWORK=Preprod
SUBMIT_RESULT_HASH=true
PAYMENT_POLL_MS=3000
PAYMENT_TIMEOUT_MS=900000
AGENT_POLL_MS=2000
AGENT_TIMEOUT_MS=900000

# --- Service: MPS (separate repo masumi-payment-service Dockerfile) ---
# DATABASE_URL=${{mps-Postgres.DATABASE_URL}}
# ENCRYPTION_KEY=REPLACE_32plus_chars_never_change_after_seed
# ADMIN_KEY=REPLACE
# PORT=3001
# BLOCKFROST_API_KEY_PREPROD=REPLACE
# SEED_ONLY_IF_EMPTY=true
# SELLING_WALLET_PREPROD_MNEMONIC=REPLACE_OR_CAPTURE_FROM_SEED_LOGS
# PURCHASE_WALLET_PREPROD_MNEMONIC=REPLACE_OR_CAPTURE_FROM_SEED_LOGS
# PAYMENT_SMART_CONTRACT_ADDRESS_PREPROD=REPLACE
# REGISTRY_POLICY_ID_PREPROD=REPLACE
# COINGECKO_API_KEY=CG-demo-key
# IS_COINGECKO_DEMO=true

