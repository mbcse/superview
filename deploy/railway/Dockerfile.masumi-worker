# Railway / Docker: Sokosumi ↔ Masumi escrow glue (can stay private)
# Set Dockerfile path to: deploy/railway/Dockerfile.masumi-worker
# Root Directory: (repo root)
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY tsconfig.base.json ./
COPY apps/masumi-worker/package.json apps/masumi-worker/tsconfig.json ./apps/masumi-worker/
COPY apps/masumi-worker/src ./apps/masumi-worker/src

WORKDIR /app/apps/masumi-worker
RUN pnpm install --prod --ignore-workspace

ENV NODE_ENV=production
ENV HOST=0.0.0.0
EXPOSE 8090

CMD ["pnpm", "exec", "tsx", "src/index.ts"]
