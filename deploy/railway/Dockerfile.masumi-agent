# Railway / Docker: MIP-003 SuperView research agent (public HTTPS)
# Set Dockerfile path to: deploy/railway/Dockerfile.masumi-agent
# Root Directory: (repo root)
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY tsconfig.base.json ./
COPY apps/masumi-agent/package.json apps/masumi-agent/tsconfig.json ./apps/masumi-agent/
COPY apps/masumi-agent/src ./apps/masumi-agent/src

WORKDIR /app/apps/masumi-agent
RUN pnpm install --prod --ignore-workspace

ENV NODE_ENV=production
ENV HOST=0.0.0.0
# Railway injects PORT
EXPOSE 8080

CMD ["pnpm", "exec", "tsx", "src/index.ts"]
