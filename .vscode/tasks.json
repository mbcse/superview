{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "${env:HOME}/.nvm/versions/node/v23.3.0/bin:${env:HOME}/Library/pnpm:/Applications/Docker.app/Contents/Resources/bin:/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "dev all",
      "detail": "Kill leftover ports, then Postgres, Redis, API, worker, and web",
      "dependsOrder": "sequence",
      "dependsOn": ["kill ports", "infra", "dev apps"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run all",
      "detail": "Kill leftover ports, then Postgres, Redis, production web build, API, worker, and next start",
      "dependsOrder": "sequence",
      "dependsOn": ["kill ports", "infra", "prod build", "prod apps"],
      "problemMatcher": []
    },
    {
      "label": "kill ports",
      "detail": "Free 3000/3001/3010/4000 and leftover api/worker/web processes",
      "type": "shell",
      "command": "for p in 3000 3001 3010 4000; do pids=$(lsof -nP -tiTCP:$p -sTCP:LISTEN 2>/dev/null || true); if [ -n \"$pids\" ]; then echo killing :$p $pids; kill -9 $pids 2>/dev/null || true; fi; done; pkill -9 -f '${workspaceFolder}/apps/api' 2>/dev/null || true; pkill -9 -f '${workspaceFolder}/apps/worker' 2>/dev/null || true; pkill -9 -f '${workspaceFolder}/apps/web' 2>/dev/null || true; echo ports cleared",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "dev apps",
      "dependsOrder": "parallel",
      "dependsOn": ["api", "worker", "web"],
      "problemMatcher": []
    },
    {
      "label": "infra",
      "type": "shell",
      "command": "export PATH=\"/Applications/Docker.app/Contents/Resources/bin:/usr/local/bin:/opt/homebrew/bin:$PATH\"; if ! docker info >/dev/null 2>&1; then open -a Docker; i=0; while [ $i -lt 60 ]; do docker info >/dev/null 2>&1 && break; i=$((i+1)); sleep 1; done; fi; docker compose up -d postgres redis",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "api",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "api",
          "pattern": {
            "regexp": "^(unused)(unused)(unused)$",
            "file": 1,
            "location": 2,
            "message": 3
          },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "listening on"
        }
      }
    },
    {
      "label": "worker",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/worker"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "worker",
          "pattern": {
            "regexp": "^(unused)(unused)(unused)$",
            "file": 1,
            "location": 2,
            "message": 3
          },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "worker scheduled"
        }
      }
    },
    {
      "label": "web",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "web",
          "pattern": {
            "regexp": "^(unused)(unused)(unused)$",
            "file": 1,
            "location": 2,
            "message": 3
          },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready|Local:)"
        }
      }
    },
    {
      "label": "prod apps",
      "dependsOrder": "parallel",
      "dependsOn": ["prod api", "prod worker", "prod web"],
      "problemMatcher": []
    },
    {
      "label": "prod build",
      "detail": "Next.js production build so the site serves compiled pages",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "prod",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "prod api",
      "type": "shell",
      "command": "pnpm exec tsx --env-file=../../.env src/index.ts",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "prod",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "prod-api",
        "pattern": {
          "regexp": "^(unused)(unused)(unused)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "listening"
        }
      }
    },
    {
      "label": "prod worker",
      "type": "shell",
      "command": "pnpm exec tsx --env-file=../../.env src/index.ts",
      "options": {
        "cwd": "${workspaceFolder}/apps/worker"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "prod",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "prod-worker",
        "pattern": {
          "regexp": "^(unused)(unused)(unused)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "worker scheduled"
        }
      }
    },
    {
      "label": "prod web",
      "type": "shell",
      "command": "pnpm start",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "prod",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "prod-web",
        "pattern": {
          "regexp": "^(unused)(unused)(unused)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready|Local:)"
        }
      }
    }
  ]
}
